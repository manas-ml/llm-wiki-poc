# --- TaskFlow API ---
PORT=3000
API_KEY=dev-local-key

# --- OpenWiki (used by `npm run wiki:update`, not by the API itself) ---
# Pick ONE provider and set its key. See:
# https://github.com/langchain-ai/openwiki#readme
#
# Anthropic
# OPENWIKI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI
# OPENWIKI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# OpenRouter (used by the generated .github/workflows/openwiki-update.yml)
# OPENWIKI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
