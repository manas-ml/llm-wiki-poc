# --- TaskFlow API ---
PORT=3000
API_KEY=dev-local-key

# --- OpenWiki (used by `npm run wiki:update`, not by the API itself) ---
# Pick ONE provider and set its key. See:
# https://github.com/langchain-ai/openwiki#readme
#
# OpenRouter running GLM-5.2 (matches the generated
# .github/workflows/openwiki-update.yml — this is the default for this repo)
OPENWIKI_PROVIDER=openrouter
OPENWIKI_MODEL_ID=z-ai/glm-5.2
# OPENROUTER_API_KEY=sk-or-...
#
# Anthropic
# OPENWIKI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI
# OPENWIKI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
